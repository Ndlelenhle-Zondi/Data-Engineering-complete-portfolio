-- Lesson 10: Build a mini pipeline [Finance]
def pipeline():
    df = pd.read_csv('payments.csv')   # 1. load
    df = df.dropna()                     # 2. clean
    df.to_csv('payments_clean.csv', index=False)  # 3. save
    return len(df)

print(pipeline())

-- Intermediate plus 2: Convert types while loading [Finance]
raw = [{"amount": "500"}, {"amount": "200"}, {"amount": "900"}, {"amount": "300"}]
clean = [{"amount": int(r["amount"])} for r in raw]
