-- Intermediate plus 5: Remove duplicate IDs [Finance]
ids = ["P1", "P2", "P3", "P4", "P1"]
seen = set()
unique = []
for i in ids:
    if i not in seen:
        seen.add(i)
        unique.append(i)
print(unique)

-- Advanced plus 1: Extract-Transform-Load functions [Finance]
def extract():
    return [500, 200, 900, 300]

def transform(rows):
    return [r * 2 for r in rows]

def load(rows):
    print("loaded", len(rows), "rows, total", sum(rows))

load(transform(extract()))
